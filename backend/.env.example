# Database
# Supabase direct connection. Replace the password locally; never commit secrets.
DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.pgepwnwygnbieefqqeqd.supabase.co:5432/postgres?sslmode=require"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cashfree — Indian customers
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2025-01-01"
CASHFREE_NOTIFY_URL="https://YOUR_RENDER_HOST/api/payments/webhook/cashfree"
CASHFREE_TEST_CUSTOMER_PHONE="9999999999"
CASHFREE_CUSTOMER_PHONE=""

# Dodo Payments — non-Indian customers
# Create a one-time USD Pay What You Want product in Dodo and copy its product ID.
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_PRODUCT_ID=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"

# Optional country/FX overrides
# Leave PAYMENT_DEFAULT_COUNTRY empty in production so the backend detects the visitor country.
PAYMENT_DEFAULT_COUNTRY=""
# The checkout uses the current published USD/INR rate from the configured FX service.
# Default service is https://api.frankfurter.app/latest?from=USD&to=INR

# Supabase Storage (server-side only; never expose service role key to frontend)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="advertisements"
