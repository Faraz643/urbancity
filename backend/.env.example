# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS
FRONTEND_URL="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cashfree Payment Gateway
# Use TEST_* credentials in sandbox and PROD_* credentials in production.
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
CASHFREE_ENV="sandbox"
CASHFREE_API_VERSION="2025-01-01"
# Optional public HTTPS endpoint for production/sandbox webhook delivery.
CASHFREE_NOTIFY_URL=""
# Sandbox can use Cashfree's test customer number; production must be your approved customer flow.
CASHFREE_TEST_CUSTOMER_PHONE="9999999999"
CASHFREE_CUSTOMER_PHONE=""
