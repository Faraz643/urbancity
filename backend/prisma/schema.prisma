generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  displayName     String?
  avatar          String?
  websiteUrl      String?
  companyDescription String?
  role            String    @default("USER")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  bids            Bid[]
  wallet          Wallet?
  transactions    Transaction[]
  advertisements  Advertisement[]
  campaigns       AdvertisingCampaign[]
  notifications   Notification[]
  bookings        Booking[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  amount      Decimal
  description String?
  status      String   @default("COMPLETED")
  referenceId String?
  createdAt   DateTime @default(now())

  @@map("transactions")
}

model Billboard {
  id                String   @id @default(uuid())
  name              String
  type              String
  positionX         Float
  positionY         Float
  positionZ         Float
  rotationY         Float    @default(0)
  width             Float    @default(4)
  height            Float    @default(2.5)
  location          String
  trafficRadius     Float    @default(50)
  trafficRating     String   @default("MEDIUM")
  visibilityRating  String   @default("GOOD")
  minBid            Decimal  @default(1000)
  currentBid        Decimal?
  currentBidderId   String?
  isAvailable       Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  auctions          Auction[]
  bids              Bid[]
  campaigns         AdvertisingCampaign[]
  trafficAnalytics  TrafficAnalytics[]
  bookings          Booking[]

  @@map("billboards")
}

model Auction {
  id            String   @id @default(uuid())
  billboardId   String
  billboard     Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  startPrice    Decimal
  currentPrice  Decimal?
  winnerId      String?
  status        String   @default("ACTIVE")
  startedAt     DateTime @default(now())
  endsAt        DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bids          Bid[]

  @@map("auctions")
}

model Bid {
  id          String    @id @default(uuid())
  auctionId   String
  auction     Auction   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidderId    String
  bidder      User      @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  billboardId String
  billboard   Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  amount      Decimal
  isWinning   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@map("bids")
}

model Advertisement {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  imageUrl    String
  targetUrl   String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   AdvertisingCampaign[]

  @@map("advertisements")
}

model AdvertisingCampaign {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  billboardId     String
  billboard       Billboard     @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("advertising_campaigns")
}

model TrafficAnalytics {
  id             String    @id @default(uuid())
  billboardId    String
  billboard      Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  nearbyVisitors Int       @default(0)
  timestamp      DateTime  @default(now())

  @@map("traffic_analytics")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model Booking {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  billboardId String
  billboard   Billboard @relation(fields: [billboardId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  durationMinutes Int
  amount      Decimal
  companyName String
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([billboardId, status, endDate])
  @@index([userId, createdAt])
  @@map("bookings")
}
